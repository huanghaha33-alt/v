<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Highlight background with prominent cyan neon border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A05D9E8" />
            <stroke android:width="2dp" android:color="#05D9E8" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <!-- Default state: Transparent subtle white shape -->
    <item android:state_focused="false">
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
