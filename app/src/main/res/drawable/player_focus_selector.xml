<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Obvious cyan neon border framing the entire player container -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#05D9E8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Default state: Transparent with a subtle border -->
    <item android:state_focused="false">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
