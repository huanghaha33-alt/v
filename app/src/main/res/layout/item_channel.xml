<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/tv_item_selector"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clipToPadding="false">

    <!-- Small colored status dot indicating live connectivity -->
    <View
        android:id="@+id/v_status_indicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/glowing_dot"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tv_channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/tv_text_selector"
        android:duplicateParentState="true"
        android:textSize="22sp"
        android:textStyle="bold"
        android:alpha="0.75"
        android:ellipsize="end"
        android:singleLine="true" />

</LinearLayout>
